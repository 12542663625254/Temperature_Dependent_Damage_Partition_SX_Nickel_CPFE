clc; clear; close all;

%% 1. SETUP: DEFINE TEMPERATURE CASES & FILES
temps = [1033, 1253]; % 760C and 980C in Kelvin
strain_amplitudes = [0.012, 0.010, 0.009, 0.008];

% Mapping PURE FATIGUE files
files_760_fat = {'cyclic_2_4.csv', 'cyclic_2_0.csv', '0_0_1_6.csv', 'cyclic_1_6.csv'};
files_980_fat = {'0_0_2_4.csv', '0_0_2_0.csv', 'cyclic_1_8.csv', '0_0_1_6.csv'}; 

% Mapping 30/30 HOLD files (Update filenames to match your local files)
files_760_hold = {'shi_30_30_2_4.csv', 'shi_30_30_2_0.csv', 'shi_30_30_1_8.csv', 'shi_30_30_1_6.csv'};
files_980_hold = {'30_30_2_4.csv', '30_30_2_0.csv', '30_30_1_6.csv', '30_30_1_6.csv'};

% Combine into a cell structure: {TempIndex}{CaseIndex}
% CaseIndex 1 = Pure Fatigue, CaseIndex 2 = 30/30 Hold
all_files = {{files_760_fat, files_760_hold}, {files_980_fat, files_980_hold}};

%% 2. MATERIAL CONSTANTS
Sg = 0.38; Sc = 0.9*Sg;
D0 = 0; Dfc = 0.9;
R = 8.314;

% Pre-allocate results [Temperature, StrainAmplitude, Case]
Df_results = zeros(length(temps), length(strain_amplitudes), 2);

%% 3. MAIN CALCULATION LOOP
for t_idx = 1:length(temps)
    for case_idx = 1:2 % 1: Pure Fatigue, 2: 30/30 Hold
        current_files = all_files{t_idx}{case_idx};
        
        for k = 1:length(strain_amplitudes)
            current_file = current_files{k};
            
            if isfile(current_file)
                data = readmatrix(current_file);
                time_col = data(:, 1);
                entropy_rate_col = data(:, 25); 
                
                Delta_Sf = 0; 
                for i = 2:length(time_col)
                    dt = time_col(i) - time_col(i-1);
                    s_dot = entropy_rate_col(i);
                    t_curr = time_col(i);
                    
                    if case_idx == 1
                    % PURE FATIGUE CASE
                    if k==1 && (t_curr > 12 && t_curr <= 60), is_active = true;
                    elseif k==2 && (t_curr > 10 && t_curr <= 50), is_active = true;
                    elseif k==3 && (t_curr > 9 && t_curr <= 45), is_active = true;
                    elseif k==4 && (t_curr > 8 && t_curr <= 40), is_active = true;
                    end
                else
                    % 30/30 HOLD TIME CASE (Expanded Windows)
                    % Capture tensile hold, compressive hold, and reversal ramps
                    if k==1 && (t_curr > 12 && t_curr <= 130), is_active = true; 
                    elseif k==2 && (t_curr > 10 && t_curr <= 120), is_active = true;
                    elseif k==3 && (t_curr > 9 && t_curr <= 115), is_active = true;
                    elseif k==4 && (t_curr > 8 && t_curr <= 110), is_active = true;
                    end
                    end
                end
                    
                    if is_active
                        Delta_Sf = Delta_Sf + (s_dot * dt);
                    end
                end
                
                % Damage Law Calculation
                if Delta_Sf >= Sg
                    Df = 1.0;
                else
                    Df = D0 + ((Dfc - D0) / log(1 - Sc/Sg)) * log(1 - Delta_Sf/Sg);
                end
                Df_results(t_idx, k, case_idx) = Df;
            end
        end
    end


%% 4. PLOTTING
fig = figure('Color', 'w', 'Units', 'centimeters', 'Position', [10, 10, 18, 16]);
hold on; box on; axis square;
color1 = [0.8500, 0.3250, 0.0980]; % Red for 760C
color2 = [0, 0.4470, 0.7410];      % Blue for 980C

% --- Plot 760C Cases ---
p1 = plot(strain_amplitudes, Df_results(1,:,1), '-o', 'Color', color1, 'LineWidth', 3, 'MarkerSize', 10, 'MarkerFaceColor', color1);
p2 = plot(strain_amplitudes, Df_results(1,:,2), '--s', 'Color', color1, 'LineWidth', 2, 'MarkerSize', 10);

% --- Plot 980C Cases ---
p3 = plot(strain_amplitudes, Df_results(2,:,1), '-o', 'Color', color2, 'LineWidth', 3, 'MarkerSize', 10, 'MarkerFaceColor', color2);
p4 = plot(strain_amplitudes, Df_results(2,:,2), '--s', 'Color', color2, 'LineWidth', 2, 'MarkerSize', 10);

% --- Formatting ---
set(gca, 'TickLabelInterpreter', 'latex', 'FontSize', 18, 'LineWidth', 1.5);
xlabel('Strain Amplitude, $\epsilon_a$', 'Interpreter', 'latex', 'FontSize', 22);
ylabel('Total Damage, $D$', 'Interpreter', 'latex', 'FontSize', 22);

legend([p1, p2, p3, p4], ...
    {'$760 ^\circ$C (Fatigue)', '$760 ^\circ$C (30s Hold)', ...
     '$980 ^\circ$C (Fatigue)', '$980 ^\circ$C (30s Hold)'}, ...
    'Location', 'best', 'Interpreter', 'latex', 'FontSize', 14);

grid on;
ylim([0, 1.1]);